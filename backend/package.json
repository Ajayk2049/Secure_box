{
  "name": "secure-box-backend",
  "version": "1.0.0",
  "description": "Secure Box IoT Fleet Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "env-cmd -f .env.dev nodemon --watch src -e ts --exec tsx src/app.ts",
    "seedAdmin": "env-cmd -f .env.dev tsx src/seedAdmin.ts",
    "build": "env-cmd -f .env.prod tsc",
    "start": "env-cmd -f .env.prod node dist/app.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.0.1",
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "fastify": "^5.2.1",
    "mongoose": "^8.9.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^4.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.10.5",
    "@types/pino": "^7.0.4",
    "@types/ws": "^8.18.1",
    "env-cmd": "^10.1.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
